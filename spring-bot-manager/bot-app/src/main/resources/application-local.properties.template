# Local development overrides
# Copy to application-local.properties and fill in real values.

server.port=3000
management.server.port=8081

spring.datasource.url=jdbc:postgresql://localhost:15432/smartbot
spring.datasource.username=smartbot
spring.datasource.password=smartbot
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true

spring.data.redis.url=redis://localhost:6379

whatsapp.verify-signature=false
whatsapp.api.version=v20.0
whatsapp.api.base-url=https://graph.facebook.com
whatsapp.app-secret=your-app-secret
whatsapp.access-token.laundry=your-laundry-access-token
whatsapp.access-token.thomasnetwork=your-thomasnetwork-access-token

campay.token=your-campay-token
campay.base-url=https://demo.campay.net
campay.auth-scheme=Token
campay.collect-path=/collect/
campay.status-path=/transaction/
campay.webhook-secret=your-campay-webhook-secret

admin.username=admin
admin.password=change-me-in-production

encryption.master-key=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

bot.config-directory=configs/bots

mqtt.url=
mqtt.username=
mqtt.password=