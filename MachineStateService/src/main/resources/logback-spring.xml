<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ── Local profile: human-readable console only ───────────────────────── -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ── All other profiles: structured JSON to stdout + Loki push ─────────── -->
    <springProfile name="!local,!test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <customFields>{"service":"machine-state-service"}</customFields>
            </encoder>
        </appender>

        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${LOKI_URL:-http://localhost:3100}/loki/v1/push</url>
                <basicAuth>
                    <username>${GRAFANA_CLOUD_LOKI_USERNAME:-0}</username>
                    <password>${GRAFANA_CLOUD_API_KEY:-}</password>
                </basicAuth>
            </http>
            <format>
                <label>
                    <pattern>service=machine-state-service,level=%level,env=${RAILWAY_ENVIRONMENT_NAME:-local}</pattern>
                </label>
                <message>
                    <pattern>traceId=%X{traceId:-} spanId=%X{spanId:-} correlationId=%X{correlationId:-} %d{ISO8601} %-5level [%logger{36}] %msg%n</pattern>
                </message>
            </format>
        </appender>

        <appender name="ASYNC_LOKI" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOKI"/>
            <neverBlock>true</neverBlock>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>
    </springProfile>
</configuration>
