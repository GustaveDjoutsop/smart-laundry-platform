# Server Configuration
PORT=3000
MANAGEMENT_PORT=8081

# Spring Profiles
SPRING_PROFILES_ACTIVE=local

# Redis (optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379

# WhatsApp Configuration
WHATSAPP_VERIFY_SIGNATURE=false
# Global app secret (single Meta app setup)
WHATSAPP_APP_SECRET=your_app_secret

# Per-bot app secrets (recommended when running multiple Meta apps)
# Naming: WHATSAPP_APP_SECRET_<BOTID_UPPER>
WHATSAPP_APP_SECRET_LAUNDRY=your_laundry_app_secret
WHATSAPP_APP_SECRET_THOMASNETWORK=your_thomasnetwork_app_secret
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE=https://graph.facebook.com

# Per-bot WhatsApp access tokens (uppercase bot ID)
# <BOTID> comes from configs/bots/*.bot.json -> botId
# Example botIds in this repo: laundry, thomasnetwork
WHATSAPP_ACCESS_TOKEN_LAUNDRY=your_laundry_bot_token
WHATSAPP_ACCESS_TOKEN_THOMASNETWORK=your_network_bot_token

# Per-bot verify tokens (used for Meta webhook handshake)
VERIFY_TOKEN_LAUNDRY=your_laundry_verify_token
VERIFY_TOKEN_THOMASNETWORK=your_network_verify_token

# CamPay Payment Configuration
# Global token (single CamPay account setup)
CAMPAY_TOKEN=your_campay_token

# Per-bot CamPay credentials (override global)
# Naming: CAMPAY_TOKEN_<BOTID_UPPER>, CAMPAY_WEBHOOK_SECRET_<BOTID_UPPER>
CAMPAY_TOKEN_LAUNDRY=your_laundry_campay_token
CAMPAY_WEBHOOK_SECRET_LAUNDRY=your_laundry_campay_webhook_secret
CAMPAY_TOKEN_THOMASNETWORK=your_thomasnetwork_campay_token
CAMPAY_WEBHOOK_SECRET_THOMASNETWORK=your_thomasnetwork_campay_webhook_secret

# Optional: Per-bot CamPay APP key/secret (NOT used by current implementation)
# If you only have APP key/secret, you must exchange them for a token yourself
# (or we can implement automatic token retrieval if you confirm CamPay's auth endpoint/flow).
# Naming: CAMPAY_APP_KEY_<BOTID_UPPER>, CAMPAY_APP_SECRET_<BOTID_UPPER>
# CAMPAY_APP_KEY_LAUNDRY=...
# CAMPAY_APP_SECRET_LAUNDRY=...
# CAMPAY_APP_KEY_THOMASNETWORK=...
# CAMPAY_APP_SECRET_THOMASNETWORK=...

# Optional per-bot overrides (otherwise global values below are used)
# CAMPAY_BASE_URL_LAUNDRY=...
# CAMPAY_AUTH_SCHEME_LAUNDRY=Token
# CAMPAY_COLLECT_PATH_LAUNDRY=/collect/
# CAMPAY_STATUS_PATH_LAUNDRY=/transaction/
# Sandbox: https://demo.campay.net/api
# Live:    https://www.campay.net/api
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_AUTH_SCHEME=Token
CAMPAY_WEBHOOK_SECRET=your_webhook_secret

# Payment Settings
PAYMENT_TTL_SECONDS=86400
PAYMENT_POLL_INTERVAL_MS=10000
PAYMENT_TIMEOUT_MS=600000

# MQTT Configuration (optional)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=

# Rate Limiting
RATE_LIMIT_WHATSAPP_WINDOW_MS=60000
RATE_LIMIT_WHATSAPP_MAX=120
RATE_LIMIT_PAYMENTS_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_PAYMENTS_WEBHOOK_MAX=120

# Queue Configuration
QUEUE_MAX_SIZE=500

# Bot Configuration
BOT_CONFIG_DIRECTORY=configs/bots

# Error tracking (R7 — Sentry). Leave SENTRY_DSN unset locally; the SDK no-ops
# with an empty DSN. Set via Doppler in staging/production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local-dev
