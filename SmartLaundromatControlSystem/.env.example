# ===========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ===========================================
# Copy this file to create environment-specific configurations:
# - .env.development (local development)
# - .env.test (CI/CD testing)
# - .env.stage (staging/UAT)
# - .env.production (live production)

# ===========================================
# ENVIRONMENT
# ===========================================
# Options: development, test, stage, production
NODE_ENV=development

# ===========================================
# SECURITY
# ===========================================
# JWT Secret for signing authentication tokens (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=generate_with_openssl_rand_hex_32

# CORS Allowed Origins (comma-separated list for production)
# Development/test environments allow all origins automatically
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Enable HSTS preload (optional, only for production with stable HTTPS setup)
# HSTS_PRELOAD=true

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000

# ===========================================
# DATABASE
# ===========================================
# Development: Local MongoDB without authentication
# Test: Local MongoDB with test database
# Stage/Production: MongoDB with authentication (username:password@host)
MONGO_URI=mongodb://localhost:27017/laundry_db

# For production/stage with authentication, use format:
# MONGO_URI=mongodb://username:password@host:port/database_name
# Or for MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# ===========================================
# MQTT BROKER
# ===========================================
# Development/Test: Public broker without authentication
# Stage/Production: Private broker WITH authentication (REQUIRED)
MQTT_BROKER_URL=mqtt://test.mosquitto.org

# MQTT Authentication (OPTIONAL for dev/test, REQUIRED for stage/prod)
# Leave empty for development with public brokers
# MQTT_USERNAME=your_mqtt_username
# MQTT_PASSWORD=your_mqtt_password

# For production with TLS/SSL:
# MQTT_BROKER_URL=mqtts://your-secure-broker.com:8883
# MQTT_USERNAME=prod_mqtt_user
# MQTT_PASSWORD=SECURE_MQTT_PASSWORD

# ===========================================
# REDIS (Session Storage)
# ===========================================
# Development: Leave empty to use in-memory storage (no Redis required)
# Stage/Production: REQUIRED for horizontal scaling and session persistence
# REDIS_URL=redis://localhost:6379

# For Heroku with Heroku Redis addon:
# REDIS_URL=redis://h:password@hostname:port
# (Automatically set by Heroku addon)

# For cloud Redis (AWS ElastiCache, DigitalOcean, etc.):
# REDIS_URL=redis://password@hostname:port
# Or with TLS: REDIS_URL=rediss://password@hostname:port

# ===========================================
# CAMPAY PAYMENT GATEWAY
# ===========================================
# For development/test: Use sandbox credentials from https://demo.campay.net
# For stage/production: Use production credentials from https://www.campay.net
CAMPAY_APP_KEY=your_app_username_here
CAMPAY_APP_SECRET=your_app_password_here

# Webhook signature secret for validating Campay webhook authenticity (REQUIRED for production)
# Get this from Campay support or your Campay dashboard
CAMPAY_WEBHOOK_SECRET=your_campay_webhook_secret

# Optional: Override Campay base URL (auto-detected from NODE_ENV)
# CAMPAY_BASE_URL=https://demo.campay.net

# ===========================================
# META (WHATSAPP) API
# ===========================================
# Get these from Meta Developer Portal: https://developers.facebook.com/apps
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ===========================================
# BUSINESS CONFIGURATION (Pricing & Cycles)
# ===========================================
# Wash cycle pricing (in XAF - Central African Francs)
PRICE_SHORT_CYCLE=1000
PRICE_LONG_CYCLE=2000

# Wash cycle durations (in minutes)
DURATION_SHORT=30
DURATION_LONG=60

# Pulse counts for machine control
PULSE_SHORT=1
PULSE_LONG=2

# ===========================================
# MACHINE CONFIGURATION
# ===========================================
# Comma-separated list of available machine IDs
MACHINE_IDS=washer_01,washer_02
