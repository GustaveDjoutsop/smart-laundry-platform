# Server
PORT=3000

# Select config/environments/<name>.yml (defaults to dev)
CONFIG_ENV=dev

# WhatsApp webhook signature verification
# Set true in production once WHATSAPP_APP_SECRET is configured
WHATSAPP_VERIFY_SIGNATURE=false
WHATSAPP_APP_SECRET=

# WhatsApp outbound messaging (per bot)
# Naming convention: WHATSAPP_ACCESS_TOKEN_<BOTID_UPPERCASE>
# Example for laundry botId: WHATSAPP_ACCESS_TOKEN_LAUNDRY=EAAG... (do not commit real tokens)
WHATSAPP_ACCESS_TOKEN_LAUNDRY=
WHATSAPP_ACCESS_TOKEN_THOMAS_NETWORK=
WHATSAPP_ACCESS_TOKEN_AFROMARKET=

# Webhook verify tokens referenced from bot configs via ${VAR} placeholders
# (see configs/bots/*.bot.json). If unset, the literal placeholder is kept.
META_VERIFY_TOKEN_LAUNDRY=
META_VERIFY_TOKEN_AFROMARKET=

# Optional
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE=https://graph.facebook.com

# Payments (CamPay)
# Do not commit real tokens.
CAMPAY_TOKEN=
CAMPAY_BASE_URL=https://www.campay.net/api
CAMPAY_AUTH_SCHEME=Token
CAMPAY_COLLECT_PATH=/collect/
CAMPAY_STATUS_PATH=/transaction/

# Optional webhook signature verification for CamPay webhooks
# If set, POST /api/payments/webhooks/campay/:botId must include a valid signature header.
CAMPAY_WEBHOOK_SECRET=
# Header name carrying signature hex, defaults to x-campay-signature
CAMPAY_WEBHOOK_SIGNATURE_HEADER=x-campay-signature

# Payments (Stripe) - used by AfroMarket only. Do not commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Billing (Stripe) - B2B subscription billing: Bot Management Service
# charging its own SMB clients a recurring hosting fee per bot. Separate
# Stripe account/keys and a separate webhook endpoint from the consumer
# Payments block above (different event types, different signing secret).
# Sandbox keys - do not commit real keys.
SANDBOX_PUBLIC_KEY=
SANDBOX_SECRET_KEY=
SANDBOX_WEBHOOK_SECRET=
STRIPE_BILLING_SUCCESS_URL=
STRIPE_BILLING_CANCEL_URL=
STRIPE_BILLING_PORTAL_RETURN_URL=

# Rate limit for the billing webhook endpoint (optional)
RATE_LIMIT_BILLING_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_BILLING_WEBHOOK_MAX=120

# Bearer token required on the admin-only billing routes (checkout-session,
# portal-session, status) - these fire real Stripe API calls and return a
# live subscription-management link, so they must not be open to anyone who
# knows a botId slug. Generate a long random value; do not commit it.
BILLING_ADMIN_TOKEN=

# Rate limit for the billing admin routes (optional)
RATE_LIMIT_BILLING_ADMIN_WINDOW_MS=60000
RATE_LIMIT_BILLING_ADMIN_MAX=30

# Optional payment record TTL
PAYMENT_TTL_SECONDS=86400

# Payment status tracking worker
PAYMENT_POLL_INTERVAL_MS=10000
PAYMENT_TIMEOUT_MS=600000

# MQTT (IoT)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic prefix fallback when bot config doesn't define mqtt.topicPrefix
MQTT_TOPIC_PREFIX=

# Redis (optional; if unset, service uses in-memory fallback)
REDIS_URL=

# Queue tuning (optional)
QUEUE_MAX_SIZE=500
NODE_ENV=dev

# Delay (ms) after a successful carousel-template send before its footer
# buttons message, to stop the footer visually racing ahead of the carousel
# on the client. Runs inside the single-threaded inbound message queue, so
# it stalls other pending messages for its duration - lower/disable (0)
# under load if needed. Default: 6000
CAROUSEL_FOOTER_DELAY_MS=6000

# Same idea as CAROUSEL_FOOTER_DELAY_MS above, but for AfroMarket's "Current
# promo" flow: upper bound (ms) to wait for the promo template's own
# delivery-status webhook before sending its follow-up options message, to
# stop that follow-up visually racing ahead of the template on the client.
# Only actually sleeps this full duration as a fallback when no webhook
# arrives in time (or no message id was returned to correlate one to) - the
# common case resolves as soon as the webhook lands, often well under this
# value. Deliberately its own variable, not a reuse of
# CAROUSEL_FOOTER_DELAY_MS - keeping them independent means retuning one
# feature's environments can't silently under-tune the other. Default: 6000
PROMO_TEMPLATE_FOOTER_DELAY_MS=6000

# WhatsApp / Meta Cloud API
META_VERIFY_TOKENS_JSON={"laundry":"REDACTED"}

# Redis (optional for dev)
REDIS_URL=

# Payments (examples)
CAMPAY_TOKEN=
MTN_MOMO_CLIENT_ID=
MTN_MOMO_CLIENT_SECRET=

# MQTT
MQTT_URL=

# ThomasNetwork Pressing
# BotId used to read washer availability from MachineStore
PRESSING_LAUNDRY_BOT_ID=laundry
