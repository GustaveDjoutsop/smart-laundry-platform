{
  "botId": "thomas_network",
  "botType": "thomas_network",
  "botName": "Thomas business Network",
  "phoneNumberId": "1030993210090797",
  "verifyToken": "myTestToken",

  "networkAccess": {
    "currency": "XAF",
    "maxDevices": 10,
    "bandwidthOptions": [
      {
        "id": "10gbps",
        "label": "10 Gigabit/s",
        "baseAmount": 2
      }
    ]
  },

  "payments": {
    "preferredProvider": "campay"
  },

  "defaultFlowId": "main_menu",
  "flows": {
    "main_menu": {
      "triggers": ["hi", "hello", "salut", "bonjour", "menu"],
      "states": [
        {
          "id": "welcome",
          "type": "buttons",
          "template": "🛜 *{{bot.name}}*\nBienvenue.\n\n📌 *Service*\nChoisis une option :",
          "buttons": [
            { "id": "1", "title": "🌐 Accès réseau" },
            { "id": "2", "title": "🧺 Pressing" }
          ],
          "saveAs": "menuChoice",
          "next": "menu_route"
        },
        {
          "id": "menu_route",
          "type": "action",
          "action": "menu.route"
        },

        {
          "id": "pressing_menu",
          "type": "buttons",
          "template": "🧺 *Pressing*\n\nChoisis une option :",
          "buttons": [
            { "id": "pressing_washers", "title": "Machines dispo" },
            { "id": "pressing_track", "title": "Suivi code" },
            { "id": "pressing_back", "title": "⬅️ Menu" }
          ],
          "saveAs": "pressingChoice",
          "next": "pressing_route"
        },
        {
          "id": "pressing_route",
          "type": "action",
          "action": "pressing.route"
        },
        {
          "id": "pressing_washer_action",
          "type": "action",
          "action": "pressing.checkWashers",
          "next": "pressing_washer_message"
        },
        {
          "id": "pressing_washer_message",
          "type": "buttons",
          "template": "{{pressingWasherText}}\n\nChoisis une option :",
          "buttons": [
            { "id": "pressing_washers", "title": "Machines dispo" },
            { "id": "pressing_track", "title": "Suivi code" },
            { "id": "pressing_back", "title": "Menu" }
          ],
          "saveAs": "pressingChoice",
          "next": "pressing_route"
        },
        {
          "id": "pressing_code_prompt",
          "type": "input",
          "prompt": "🏷️ *Suivi Pressing*\n\nEnvoie ton *code pressing* (ex: PRS1234) :",
          "saveAs": "pressingCode",
          "next": "pressing_code_action"
        },
        {
          "id": "pressing_code_action",
          "type": "action",
          "action": "pressing.checkCode",
          "next": "pressing_code_message"
        },
        {
          "id": "pressing_code_message",
          "type": "buttons",
          "template": "{{pressingCodeText}}\n\nChoisis une option :",
          "buttons": [
            { "id": "pressing_washers", "title": "Machines dispo" },
            { "id": "pressing_track", "title": "Suivi code" },
            { "id": "pressing_back", "title": "Menu" }
          ],
          "saveAs": "pressingChoice",
          "next": "pressing_route"
        },

        {
          "id": "bandwidth_list_action",
          "type": "action",
          "action": "bandwidth.list",
          "next": "bandwidth_prompt"
        },
        {
          "id": "bandwidth_prompt",
          "type": "buttons",
          "template": "{{#errorText}}⚠️ {{errorText}}\n\n{{/errorText}}📶 *Choix du débit* (1 journée)\n\n{{bandwidthOptionsText}}\n\nAppuie sur un bouton :",
          "buttonsFromContext": "bandwidthButtons",
          "saveAs": "bandwidthChoiceInput",
          "next": "bandwidth_validate_action"
        },
        {
          "id": "bandwidth_validate_action",
          "type": "action",
          "action": "bandwidth.validate"
        },

        {
          "id": "devices_prompt",
          "type": "buttons",
          "template": "📱 *Nombre d'appareils*\nChoisis le nombre d'appareils à connecter :",
          "buttons": [
            { "id": "1", "title": "1 appareil (skip)" },
            { "id": "2", "title": "2 appareils" },
            { "id": "4", "title": "4 appareils" },
            { "id": "6", "title": "6 appareils" }
          ],
          "saveAs": "deviceCountInput",
          "next": "devices_calculate_action"
        },
        {
          "id": "devices_calculate_action",
          "type": "action",
          "action": "devices.calculate"
        },

        {
          "id": "payment_initiate_action",
          "type": "action",
          "action": "payments.initiate"
        },
        {
          "id": "payment_pending",
          "type": "message",
          "template": "💳 *Paiement Mobile Money*\n\nService: 🌐 Accès réseau (1 journée)\nDébit: *{{bandwidthLabel}}*\nAppareils: *{{deviceCount}}*\nTotal: *{{paymentAmount}} {{paymentCurrency}}*\n\nRéférence: {{paymentExternalRef}}\n\nUne demande de paiement peut s'afficher sur votre téléphone. Une fois payé, je vous enverrai votre *code d'accès* ici.",
          "next": "welcome"
        }
      ]
    }
  }
}
