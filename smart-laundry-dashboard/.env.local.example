# Smart Laundry Dashboard - Environment Configuration
# Copy this file to .env.local and update the values

# ==============================================
# Backend API URL
# ==============================================
# The Smart Laundromat Control System backend server

# For LOCAL development (backend running locally on port 3000):
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# For TEST environment (Heroku deployment):
# NEXT_PUBLIC_API_URL=https://smartlaundry-2ac76a884b66.herokuapp.com/api

# ==============================================
# Usage
# ==============================================
# Option 1: Edit .env.local and run `npm run dev`
# Option 2: Use npm scripts:
#   - npm run dev        -> Uses .env.local (default: local backend)
#   - npm run dev:local  -> Uses .env.local (local backend)
#   - npm run dev:test   -> Uses .env.test (Heroku TEST backend)
