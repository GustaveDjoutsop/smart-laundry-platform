# Smart Laundry Dashboard — Environment Configuration Template

# API Gateway → Reporting BFF (analytics, revenue, transactions, machines, feedback)
# Dev:  http://localhost:8080/reports/api
# Prod: https://api.smartlaundry.cm/reports/api  (set when gateway is deployed)
NEXT_PUBLIC_BFF_URL=http://localhost:8080/reports/api

# ── Auth0 v4 (P6b) ──────────────────────────────────────────────────────────
# SDK: @auth0/nextjs-auth0 v4   Docs: https://github.com/auth0/nextjs-auth0
# Auth0 application type: Regular Web Application (NOT SPA)
# Auth0 dashboard URLs to register:
#   Allowed Callback URLs : http://localhost:3000/auth/callback
#   Allowed Logout URLs   : http://localhost:3000
#   Allowed Web Origins   : http://localhost:3000
#
# Doppler project: smart-laundry-dashboard
AUTH0_DOMAIN=dev-iuo6si32jobgnmod.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Legacy Doppler names (still supported via lib/auth0.ts bridge):
# AUTH0_ISSUER_BASE_URL=https://dev-iuo6si32jobgnmod.eu.auth0.com
# AUTH0_BASE_URL=http://localhost:3000

# ── Error tracking (R7 — Sentry) ────────────────────────────────────────────
# DSN is not a secret (Sentry's own docs say so), but the NEXT_PUBLIC_ prefix
# is required for Next.js to inline it into the client bundle. SENTRY_DSN
# (server/edge) and NEXT_PUBLIC_SENTRY_DSN (browser) are typically the same
# value from the same Sentry project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# Source map upload at build time only — CI/build environment, not runtime.
# SENTRY_AUTH_TOKEN is a real secret (scoped Sentry auth token); never commit it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
