# Smart Laundry Dashboard — Environment Configuration Template

# API Gateway → Reporting BFF (analytics, revenue, transactions, machines, feedback)
# Dev:  http://localhost:8080/reports/api
# Prod: https://api.smartlaundry.cm/reports/api  (set when gateway is deployed)
NEXT_PUBLIC_BFF_URL=http://localhost:8080/reports/api

# ── Auth0 v4 (P6b) ──────────────────────────────────────────────────────────
# SDK: @auth0/nextjs-auth0 v4   Docs: https://github.com/auth0/nextjs-auth0
# Auth0 application type: Regular Web Application (NOT SPA)
# R6: dev server runs on 3001 (package.json `next dev -p 3001`), not 3000 --
# 3000 is the legacy SmartLaundromatControlSystem monolith / BotManagerService.
# If the Auth0 tenant's registered URLs still say 3000, update them there too --
# that's an external Auth0 dashboard setting this repo can't fix by itself.
# Auth0 dashboard URLs to register:
#   Allowed Callback URLs : http://localhost:3001/auth/callback
#   Allowed Logout URLs   : http://localhost:3001
#   Allowed Web Origins   : http://localhost:3001
#
# Doppler project: smart-laundry-dashboard
AUTH0_DOMAIN=dev-iuo6si32jobgnmod.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3001

# Legacy Doppler names (still supported via lib/auth0.ts bridge):
# AUTH0_ISSUER_BASE_URL=https://dev-iuo6si32jobgnmod.eu.auth0.com
# AUTH0_BASE_URL=http://localhost:3001
