{
  "title": "Smart Laundry — Platform SLOs",
  "uid": "smart-laundry-slos",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["smart-laundry"],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Service Availability",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API Gateway",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"api-gateway\"}", "legendFormat": "Gateway" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Payment Service",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"payment-management-service\"}", "legendFormat": "PMS" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Machine State",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"machine-state-service\"}", "legendFormat": "MSS" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Reporting BFF",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"reporting-bff\"}", "legendFormat": "BFF" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Bot Manager",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "up{job=\"bot-manager\"}", "legendFormat": "Bot" }]
    },

    {
      "id": 10,
      "type": "row",
      "title": "HTTP Latency (SLO: p95 < 500ms)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP p50 / p95 / p99 — All Services",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 2.0 }
          ]}
        }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p50 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p95 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p99 {{job}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP Error Rate (5xx)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]}
        }
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx rate — {{job}}"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "Outbox Relay (Pay→Start SLO)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Outbox Pending Now",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 15 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
          ]}
        }
      },
      "targets": [{ "expr": "outbox_relay_pending", "legendFormat": "Pending" }]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Dead-Letter Events (all time)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 15 },
      "datasource": { "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "targets": [{ "expr": "outbox_relay_dead_letter_total", "legendFormat": "Dead Letters" }]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Outbox Processed Rate & Dead-Letters (5m)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 15 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        {
          "expr": "rate(outbox_relay_processed_total[5m])",
          "legendFormat": "Processed / s"
        },
        {
          "expr": "rate(outbox_relay_dead_letter_total[5m])",
          "legendFormat": "Dead-Lettered / s"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Outbox Pending (trend)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 19 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
          ]}
        }
      },
      "targets": [{ "expr": "outbox_relay_pending", "legendFormat": "Pending" }]
    },

    {
      "id": 30,
      "type": "row",
      "title": "Machine Cycles",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Cycle Starts per Minute",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum by (cycle_type) (rate(machine_cycle_started_total[5m])) * 60",
          "legendFormat": "{{cycle_type}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Idempotent Returns (duplicates suppressed)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "rate(machine_cycle_idempotent_total[5m]) * 60",
          "legendFormat": "Idempotent hits / min"
        }
      ]
    },

    {
      "id": 40,
      "type": "row",
      "title": "JVM & Connection Pools",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "JVM Heap Usage",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 32 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Heap used — {{job}}"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Heap max — {{job}}"
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "HikariCP — Active / Pending connections",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 32 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active — {{job}}"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "Pending — {{job}}"
        }
      ]
    }
  ]
}
